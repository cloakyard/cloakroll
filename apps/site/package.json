{
  "name": "cloakroll-site",
  "version": "1.0.0",
  "private": true,
  "description": "CloakRoll — roll.cloakyard.com",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "npm run check && npm run build && node scripts/verify-site.mjs",
    "check:worker": "wrangler deploy --dry-run --outdir build/worker",
    "deploy": "npm run verify && wrangler deploy",
    "predev": "node scripts/sync-assets.mjs",
    "prebuild": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true,
    "fsevents@2.3.3": true
  },
  "packageManager": "npm@12.2.2"
}
