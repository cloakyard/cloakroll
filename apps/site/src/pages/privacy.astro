---
import { compiledContent, rawContent } from '../../../../docs/PRIVACY.md';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Footer from '../components/Footer.astro';
const revision = rawContent().match(/^Updated ([^.]+)\./m)?.[1];
if (!revision) throw new Error('The app privacy policy needs its revision date.');
const revisionISO = new Date(`${revision} UTC`).toISOString().slice(0, 10);
const revisionLabel = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(revisionISO));
// Render the maintained policy; preserve the website's published section anchors.
const policy = (await compiledContent())
  .replace(/^<h1[^>]*>[\s\S]*?<\/h1>\s*/, '')
  .replace(/<p>Updated [^.]+\. /, '<p>')
  .replace('id="what-the-app-reads-and-saves"', 'id="data"')
  .replace('id="storage-and-control"', 'id="storage"')
  .replaceAll('<h2 id=', '<h2 tabindex="-1" id=');
---
<BaseLayout title="Privacy policy — CloakRoll" description="Your originals belong to you. Here is what the app reads, where it saves data, and what you control.">
  <Header linkPrefix="/" />
  <main id="main" class="air-page air-policy frame" tabindex="-1">
    <a class="air-policy-back" href="/"><Icon name="back" size={16} />Back to CloakRoll</a>
    <header class="air-policy-intro">
      <p class="air-page-eyebrow">CloakRoll · Privacy</p>
      <h1 id="privacy-title">Privacy policy</h1>
      <p class="air-page-lede">Your originals belong to you. Here is what the app reads, where it saves data, and what you control.</p>
      <p class="air-page-meta">Last updated <time datetime={revisionISO}>{revisionLabel}</time></p>
    </header>
    <div class="air-reading-layout">
      <details class="air-contents" open>
        <summary>On this page <Icon name="chevron" size={18} /></summary>
        <nav aria-label="Policy contents"><a href="#data">What the app reads and saves</a><a href="#storage">Storage and control</a><a href="#website">This website</a><a href="#questions">Questions</a></nav>
      </details>
      <article class="air-prose" aria-label="CloakRoll privacy policy"><Fragment set:html={policy} /><h2 id="website" tabindex="-1">This website</h2><p>This static site has no analytics, advertising, accounts or tracking cookies. Cloudflare serves the site and may process request information for delivery and security under its <a href="https://www.cloudflare.com/privacypolicy/">privacy policy</a>. GitHub handles downloads and feedback under its own policy. No app media is sent to this website.</p><h2 id="questions" tabindex="-1">Questions</h2><p>For questions, <a href="https://github.com/cloakyard/cloakroll/issues">open an issue</a>. Avoid attaching personal photos or device identifiers to a public report.</p></article>
    </div>
  </main>
  <Footer />
</BaseLayout>
