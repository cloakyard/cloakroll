---
interface Props {
  scene: 'mountains' | 'coast' | 'flowers' | 'city' | 'forest';
}
const { scene } = Astro.props;
---
<svg viewBox="0 0 100 124" width="100" height="124" focusable="false" data-scene={scene}>
  {scene === 'mountains' && <>
    <rect width="100" height="124" fill="#ded6f0"/>
    <circle cx="72" cy="27" r="12" fill="#f4ce86"/>
    <path d="M0 77 30 42 58 76 80 55 100 77V124H0Z" fill="#b6a0d1"/>
    <path d="M0 92 45 53 85 100 100 88V124H0Z" fill="#79689b"/>
    <path d="M0 106Q30 83 60 109T100 103V124H0Z" fill="#564b79"/>
  </>}
  {scene === 'coast' && <>
    <rect width="100" height="124" fill="#dce9e5"/>
    <path d="M8 28H38Q37 21 30 22Q24 11 17 22Q9 21 8 28Z" fill="#f5f4e9"/>
    <path d="M0 48Q28 44 52 48T100 47V124H0Z" fill="#8dbbb8"/>
    <path d="M0 70Q26 81 35 101T72 124H0Z" fill="#f0dfbd"/>
    <path d="M0 64Q32 76 40 99T83 124" fill="none" stroke="#e8f1e9" stroke-width="3"/>
    <path d="M53 66H81L75 73H59Z" fill="#456e79"/>
    <path d="M66 35V62H50Z" fill="#faf7ed"/>
    <path d="M69 43 80 62H69Z" fill="#d6e4df"/>
    <path d="M57 79H76M70 92H91M9 54H28" stroke="#bfe0d7" stroke-width="2" stroke-linecap="round"/>
  </>}
  {scene === 'flowers' && <>
    <rect width="100" height="124" fill="#efe1d6"/>
    <path d="M0 111Q45 98 100 110V124H0Z" fill="#dec8b7"/>
    <path d="M56 124Q43 90 48 52M49 103Q64 82 72 77" fill="none" stroke="#648775" stroke-width="3"/>
    <path d="M48 97Q23 96 25 77Q45 76 48 97ZM53 99Q76 104 84 88Q66 79 53 99Z" fill="#8fa28a"/>
    <g fill="#c88a91">
      <ellipse cx="47" cy="35" rx="11" ry="16"/>
      <ellipse cx="47" cy="65" rx="11" ry="16"/>
      <ellipse cx="32" cy="50" rx="16" ry="11"/>
      <ellipse cx="62" cy="50" rx="16" ry="11"/>
    </g>
    <circle cx="47" cy="50" r="10" fill="#f0cc81"/>
    <circle cx="73" cy="76" r="9" fill="#e4b77a"/>
    <circle cx="73" cy="76" r="4" fill="#f7e4b4"/>
  </>}
  {scene === 'city' && <>
    <rect width="100" height="124" fill="#d5dced"/>
    <path d="M77 15A12 12 0 1 0 89 29A12 12 0 0 1 77 15Z" fill="#f5dfb2"/>
    <path d="M0 81H8V57H23V68H39V48H53V76H69V55H85V70H100V124H0Z" fill="#a4b1c9"/>
    <path d="M0 94H13V73H35V124H0Z" fill="#6c819d"/>
    <path d="M39 124V58H48V44H54V58H63V124Z" fill="#536b8c"/>
    <path d="M70 124V82H91V93H100V124Z" fill="#7a8fa9"/>
    <path d="M19 83H24M19 94H24M47 69H54M47 81H54M47 93H54M77 94H83M77 105H83"
      stroke="#f1d7a5" stroke-width="4"/>
    <path d="M0 117H100V124H0Z" fill="#445b77"/>
  </>}
  {scene === 'forest' && <>
    <rect width="100" height="124" fill="#dce5d6"/>
    <circle cx="65" cy="28" r="13" fill="#f1db9d"/>
    <path d="M0 70Q28 43 58 65T100 59V124H0Z" fill="#b1c5ab"/>
    <path d="M0 98Q44 71 100 92V124H0Z" fill="#7b9b81"/>
    <path d="M62 124Q34 106 57 93Q68 85 59 76Q77 85 67 95Q50 109 86 124Z" fill="#d9d4af"/>
